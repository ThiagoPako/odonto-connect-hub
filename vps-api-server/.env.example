# ─── PostgreSQL local ────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=odonto_db
PG_USER=odonto_user
PG_PASSWORD=SUA_SENHA_AQUI

# ─── JWT ─────────────────────────────────────
JWT_SECRET=GERE_UM_SECRET_FORTE_AQUI

# ─── Evolution API ───────────────────────────
EVOLUTION_API_URL=https://api.odontoconnect.tech
EVOLUTION_API_KEY=SUA_CHAVE_DA_EVOLUTION_API_AQUI
# Segredo do webhook da Evolution (só letras e números). Gere com: openssl rand -hex 32
EVOLUTION_WEBHOOK_SECRET=
# ─── Provedores de WhatsApp (docs/whatsapp/migracao-provedores.md) ───
# Chave AES-256-GCM das credenciais dos canais: 64 hex (ou base64 canônico de 32 bytes).
# O deploy.yml gera na VPS se faltar. NUNCA trocar depois de existir dado cifrado (perde as
# credenciais); backup junto do .env. Rotação: nova chave aqui com VERSION+1 e a antiga em
# PREVIOUS ("1:<chave antiga>").
WA_CREDENTIALS_KEY=
WA_CREDENTIALS_KEY_VERSION=1
WA_CREDENTIALS_KEY_PREVIOUS=
# OpenWA (reserva por QR) — só local, no host: http://127.0.0.1:2785
OPENWA_URL=http://127.0.0.1:2785
# Chave ADMIN do OpenWA (= API_MASTER_KEY de /root/openwa/.env). Só neste .env; nunca no navegador.
OPENWA_ADMIN_KEY=
# Base que o OpenWA usa para chamar a API (rota interna nginx, docs/operacao/openwa-vps.md)
OPENWA_WEBHOOK_BASE=http://172.30.50.1:8081
# Fuso usado nas janelas de envio do WhatsApp
TZ=America/Sao_Paulo

# ─── SMTP (Nodemailer) ───────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
SMTP_FROM=Odonto Connect <noreply@odontoconnect.tech>

# ─── App URL ─────────────────────────────────
APP_URL=https://odontoconnect.tech

# ─── Server ──────────────────────────────────
API_PORT=3002

# ─── Web Push (VAPID) ────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── AI (configurável via painel) ────────────
# As API keys de IA são gerenciadas pelo painel em /configuracoes
# Não é necessário configurar aqui — use a interface web

# Retenção na OpenAI informada no consentimento de IA (valor fechado: 30d | zero).
# Use "zero" só se a retenção zero (ZDR) estiver contratada na conta da OpenAI.
OPENAI_RETENCAO=30d
# Interface em que a API escuta (padrão 127.0.0.1; nginx faz o proxy)
#API_HOST=127.0.0.1
